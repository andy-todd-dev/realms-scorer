{
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/marcellus": "^0.4.1",
    "@expo/html-elements": "^0.12.5",
    "@gluestack-ui/core": "5.0.15",
    "@gluestack-ui/utils": "5.0.6",
    "@legendapp/motion": "^2.5.3",
    "@reduxjs/toolkit": "^2.13.0",
    "awilix": "^13.0.5",
    "expo": "~57.0.32",
    "expo-dev-client": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^1.69.0",
    "nativewind": "5.0.0-rc.1",
    "react": "19.2.3",
    "react-aria": "^3.53.1",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css": "3.1.0-rc.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.3.1",
    "react-stately": "^3.51.0",
    "tailwind-variants": "^0.1.20"
  },
  "name": "realms-scorer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "preandroid": "tsc --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "ui:add": "sh scripts/ui-add.sh",
    "test:e2e": "sh scripts/with-metro.sh 'adb reverse tcp:8081 tcp:8081 && maestro test -e APP_BUILD=debug .maestro'",
    "test:e2e:build": "sh scripts/with-metro.sh 'EXPO_OFFLINE=1 expo run:android --no-bundler && npm run test:e2e'",
    "test:e2e:release": "maestro test -e APP_BUILD=release .maestro",
    "test:e2e:build:release": "EXPO_OFFLINE=1 expo run:android --variant release --no-bundler && npm run test:e2e:release",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.4",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "husky": "9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "4.2.4",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest/setup.js"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/jest/style-stub.js",
      "^lucide-react-native/icons/(.*)$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/icons/$1.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|immer|redux|react-redux|redux-thunk|reselect|@reduxjs/toolkit|nativewind|@gluestack-ui|@legendapp|tailwind-variants))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "main": "src/main.tsx",
  "overrides": {
    "lightningcss": "1.30.1",
    "@legendapp/motion": {
      "nativewind": "$nativewind"
    }
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
